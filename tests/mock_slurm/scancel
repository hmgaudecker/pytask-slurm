#!/usr/bin/env python3
"""Mock scancel: kill processes by job ID."""
# ruff: noqa: S108

from __future__ import annotations

import contextlib
import json
import os
import signal
import sys
from pathlib import Path

STATE_DIR = Path(os.environ.get("MOCK_SLURM_STATE", "/tmp/mock_slurm_state"))
jobs_file = STATE_DIR / "jobs.json"

if not jobs_file.exists():
    sys.exit(0)

jobs = json.loads(jobs_file.read_text())

for job_id in sys.argv[1:]:
    job = jobs.get(job_id.strip())
    if job and job.get("pid"):
        with contextlib.suppress(OSError):
            os.kill(int(job["pid"]), signal.SIGTERM)
